{
  "name": "photokit-node",
  "private": true,
  "version": "0.1.0",
  "description": "A macOS PhotoKit bridge with a typed Node.js API and CLI.",
  "license": "MIT",
  "author": "Jan Ole Suhr",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "PHOTOKIT_NODE_HELPER_PATH=\"${PHOTOKIT_NODE_HELPER_PATH:-$PWD/native/photokit-helper/scripts/run.sh}\" tsx packages/cli/src/bin.ts",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --cache --cache-strategy content --fix",
    "native:build": "sh native/photokit-helper/scripts/build.sh",
    "native:package": "sh native/photokit-helper/scripts/package.sh",
    "native:run": "sh native/photokit-helper/scripts/run.sh",
    "native:test": "swift test --package-path native/photokit-helper",
    "ok": "pnpm run build && pnpm run typecheck && pnpm run lint:fix && pnpm run test",
    "package:smoke": "pnpm run package:verify && node scripts/smoke-installed-package.mjs",
    "package:stage": "pnpm run native:package && node scripts/stage-package-skill.mjs",
    "package:verify": "pnpm run build && pnpm run package:stage && node scripts/verify-package.mjs",
    "qa": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.15.30",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "9.39.4",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "63.0.0",
    "esbuild": "0.28.2",
    "globals": "16.0.0",
    "tsup": "8.5.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
